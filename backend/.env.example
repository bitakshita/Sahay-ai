# Get your Gnani key from https://app.gnani.ai/voice
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
# Optional: override the voice (must belong to the chosen TTS model)
GNANI_TTS_VOICE=
# Optional LLM (Anthropic). Without it, the app uses simple built-in rules.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
